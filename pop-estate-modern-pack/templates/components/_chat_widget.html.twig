<div id="chatWidget">
  <button id="chatFab" class="chat-fab" title="Abrir asistente Pop AI"><i class="bi bi-chat-dots-fill"></i><span class="pulse"></span></button>
  <div id="chatPanel" class="chat-panel d-none">
    <div class="chat-header" id="chatHeader">
      <div class="d-flex align-items-center gap-2"><div class="bot-avatar"><i class="bi bi-robot"></i></div><div><strong>Pop AI Agent</strong><small class="d-block opacity-75">Disponible en toda la app • /api/chat</small></div></div>
      <div class="d-flex gap-1"><button class="btn btn-sm btn-ghost text-white" id="chatMinimize" title="Minimizar"><i class="bi bi-dash-lg"></i></button><button class="btn btn-sm btn-ghost text-white" id="chatClose" title="Cerrar"><i class="bi bi-x-lg"></i></button></div>
    </div>
    <div class="chat-messages" id="chatMessages">
      <div class="msg bot">¡Hola! Soy Pop AI. Estoy levantado en cualquier ventana. Pregúntame por facturación, liquidaciones o propiedades.</div>
      <div class="suggestions" id="chatSuggestions">
        <button class="sugg" data-prompt="¿Cuánto facturamos este mes?">💰 ¿Cuánto facturamos este mes?</button>
        <button class="sugg" data-prompt="Propiedades sin liquidar en 2025-12">🏠 Propiedades sin liquidar</button>
        <button class="sugg" data-prompt="Generar archivo SII del periodo 2025-12">📄 Generar SII 2025-12</button>
        <button class="sugg" data-prompt="Top 5 empresas por facturación">📊 Top empresas</button>
      </div>
    </div>
    <div class="chat-input">
      <input type="text" id="chatInput" placeholder="Escribe tu consulta..." autocomplete="off">
      <button id="chatSend" class="btn-send"><i class="bi bi-send-fill"></i></button>
    </div>
  </div>
</div>
