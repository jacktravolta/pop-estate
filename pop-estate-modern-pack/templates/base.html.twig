<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Pop Estate{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="{{ asset('css/dashboard.css') }}?v=4" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<div class="app-wrapper">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo"><i class="bi bi-buildings"></i> Pop Estate</div>
            <button class="btn btn-sm btn-ghost d-lg-none" id="sidebarClose"><i class="bi bi-x-lg"></i></button>
        </div>
        <nav class="sidebar-nav">
            <a href="{{ path('dashboard') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'dashboard' ? 'active' : '' }}"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="{{ path('company_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'company' ? 'active' : '' }}"><i class="bi bi-building"></i> Empresas <span class="ms-auto badge bg-white text-dark">100</span></a>
            <a href="{{ path('owner_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'owner' ? 'active' : '' }}"><i class="bi bi-people"></i> Propietarios</a>
            <a href="{{ path('property_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'property' ? 'active' : '' }}"><i class="bi bi-house-door"></i> Propiedades</a>
            <a href="{{ path('settlement_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'settlement' ? 'active' : '' }}"><i class="bi bi-receipt"></i> Liquidaciones</a>
            <a href="{{ path('invoice_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'invoice' ? 'active' : '' }}"><i class="bi bi-file-earmark-text"></i> Facturación</a>
            <a href="{{ path('invoice_generator') }}" class="nav-link"><i class="bi bi-magic"></i> Generador SII</a>
            <a href="{{ path('bi_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'bi' ? 'active' : '' }}"><i class="bi bi-bar-chart"></i> BI</a>
            <a href="{{ path('chat_index') }}" class="nav-link {{ app.request.attributes.get('_route') starts with 'chat' ? 'active' : '' }}"><i class="bi bi-robot"></i> Chat AI</a>
            <a href="{{ path('api_docs') }}" class="nav-link"><i class="bi bi-code-slash"></i> API Docs</a>
        </nav>
        <div class="sidebar-footer">
            <div class="user-card">
                <img src="https://i.pravatar.cc/40?img=12" class="avatar">
                <div><div class="fw-semibold">Admin Pop</div><small class="text-muted">admin@pop.cl</small></div>
                <a href="{{ path('app_logout') }}" class="ms-auto btn btn-sm btn-ghost text-white-50"><i class="bi bi-box-arrow-right"></i></a>
            </div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <button class="btn btn-ghost d-lg-none" id="sidebarOpen"><i class="bi bi-list fs-4"></i></button>
            <div class="global-search">
                <i class="bi bi-search"></i>
                <input type="text" id="globalSearch" placeholder="Buscar empresa, propiedad, RUT, rol...">
                <div class="search-results shadow-lg" id="globalSearchResults"></div>
            </div>
            <div class="topbar-actions">
                <button class="btn btn-ghost position-relative"><i class="bi bi-bell fs-5"></i><span class="notif-dot"></span></button>
                <div class="avatar-stack"><img src="https://i.pravatar.cc/32?img=12" class="avatar-sm"></div>
            </div>
        </header>
        <div class="content">
            <div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080"></div>
            {% for label, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label }} alert-dismissible fade show">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endfor %}{% endfor %}
            {% block body %}{% endblock %}
        </div>
    </div>
</div>

{% include 'components/_chat_widget.html.twig' %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="{{ asset('js/app.js') }}?v=4"></script>
<script src="{{ asset('js/chat_widget.js') }}?v=4"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
