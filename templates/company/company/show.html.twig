{% extends 'base.html.twig' %}
{% block title %}{{ company.razonSocial }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><a href="{{ path('app_company_index') }}" class="btn btn-sm btn-light mb-2"><i class="bi bi-arrow-left"></i> Empresas</a><h3 class="fw-bold mb-0">{{ company.razonSocial }}</h3><small class="text-muted">{{ company.rut }}</small></div>
  <a href="{{ path('app_company_edit', {'id': company.id}) }}" class="btn btn-light"><i class="bi bi-pencil"></i> Editar</a>
</div>
<div class="card-modern p-4">
  <div class="row g-3">
    <div class="col-md-4"><label class="small text-muted">RUT</label><div class="fw-semibold">{{ company.rut }}</div></div>
    <div class="col-md-4"><label class="small text-muted">Giro</label><div>{{ company.giro|default('—') }}</div></div>
    <div class="col-md-4"><label class="small text-muted">Dirección</label><div>{{ company.direccion|default('—') }}</div></div>
  </div>
</div>
{% endblock %}
