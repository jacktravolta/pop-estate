{% extends 'base.html.twig' %}{% block title %}Empresas{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1">Empresas</h3><p class="text-muted small mb-0">{{ pagination.getTotalItemCount }} registradas</p></div>
  <a href="{{ path('app_company_new') }}" class="btn btn-indigo rounded-pill"><i class="bi bi-plus-lg me-1"></i> Nueva empresa</a>
</div>
{% include 'company/_search.html.twig' %}
<div class="card-modern p-3">
<div class="table-responsive">
<table class="table align-middle mb-0"><thead><tr class="small text-uppercase text-muted"><th>RUT</th><th>Razón Social</th><th>Comuna</th><th class="text-end">Acciones</th></tr></thead>
<tbody>{% for c in pagination %}<tr><td><span class="badge bg-light text-dark border">{{ c.rut }}</span></td><td class="fw-semibold">{{ c.razonSocial }}</td><td>{{ c.comuna|default('—') }}</td><td class="text-end"><a href="{{ path('app_company_show',{'id':c.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye"></i></a> <a href="{{ path('app_company_edit',{'id':c.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-pencil"></i></a></td></tr>{% else %}<tr><td colspan="4" class="text-center py-5 text-muted">Sin resultados para "{{ q }}"</td></tr>{% endfor %}</tbody>
</table></div>
<div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
</div>{% endblock %}
