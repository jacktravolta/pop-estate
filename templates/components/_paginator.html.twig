{% if pagination is defined and pagination.getPageCount is defined and pagination.getPageCount() > 1 %}
<div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
<div class="small text-muted" style="font-size:12px">Página {{ pagination.getCurrentPageNumber() }} de {{ pagination.getPageCount() }} • {{ pagination.getTotalItemCount() }} registros</div>
<nav><ul class="pagination mb-0" style="gap:6px; display:flex; list-style:none; padding:0; margin:0">
{% for p in 1..pagination.getPageCount() %}
{% if p==1 or p==pagination.getPageCount() or (p >= pagination.getCurrentPageNumber()-2 and p <= pagination.getCurrentPageNumber()+2) %}
<li><a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({'page':p})) }}" class="page-link rounded-pill" style="padding:7px 14px; min-width:38px; text-align:center; text-decoration:none; display:block; font-size:13px; border:1px solid {% if p==pagination.getCurrentPageNumber() %}#4f46e5{% else %}#e2e8f0{% endif %}; background:{% if p==pagination.getCurrentPageNumber() %}#4f46e5{% else %}#fff{% endif %}; color:{% if p==pagination.getCurrentPageNumber() %}#fff{% else %}#475569{% endif %}; {% if p==pagination.getCurrentPageNumber() %}font-weight:700; box-shadow:0 4px 12px rgba(79,70,229,.35){% endif %}">{{ p }}</a></li>
{% elseif p==pagination.getCurrentPageNumber()-3 or p==pagination.getCurrentPageNumber()+3 %}
<li><span class="page-link rounded-pill" style="border:none; background:transparent">…</span></li>
{% endif %}
{% endfor %}
</ul></nav>
</div>
{% endif %}
