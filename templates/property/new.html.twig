{% extends "base_ajax.html.twig" %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
<h5 class="fw-bold mb-0" style="letter-spacing:-.02em"><i class="bi bi-plus-circle me-2" style="color:#6366f1"></i>Nueva propiedad</h5>
<span class="badge" style="background:#f3f4f6;color:#6b7280;border-radius:20px;padding:6px 12px">Borrador</span>
</div>
{{ form_start(form, {"attr":{"class":"needs-validation","novalidate":"novalidate"}}) }}
<div class="row g-3">
{% for child in form %}
{% if child.vars.name != "_token" %}
<div class="col-12 {% if child.vars.name in ["comuna","rol"] %}col-md-6{% endif %}">
<label class="form-label small fw-semibold text-muted text-uppercase" style="font-size:11px;letter-spacing:.05em">{{ child.vars.label|default(child.vars.name) }}</label>
{{ form_widget(child, {"attr":{"class":"form-control","style":"border-radius:12px;height:44px;background:#f9fafb;border:1px solid #e5e7eb"}}) }}
<div class="form-text small text-danger">{{ form_errors(child) }}</div>
</div>
{% endif %}
{% endfor %}
</div>
<div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
<button type="button" class="btn" style="border-radius:12px;height:44px;padding:0 20px;background:#f3f4f6" data-bs-dismiss="modal">Cancelar</button>
<button class="btn text-white fw-semibold" style="background:#6366f1;border-radius:12px;height:44px;padding:0 24px;box-shadow:0 4px 14px rgba(99,102,241,.35)"><i class="bi bi-check2 me-1"></i> Guardar propiedad</button>
</div>
{{ form_end(form) }}
{% endblock %}
