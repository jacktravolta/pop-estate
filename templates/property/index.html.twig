{% extends "base.html.twig" %}
{% block body %}
<style>
.kpi-card{border-radius:20px;padding:20px;border:1px solid #f3f4f6;background:white;position:relative;overflow:hidden;transition:.2s}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 12px 24px rgba(0,0,0,.07)}
.kpi-icon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px}
.kpi-bg{position:absolute;right:-20px;top:-20px;width:120px;height:120px;border-radius:50%;opacity:.08}
.progress-thin{height:6px;border-radius:10px;background:#f3f4f6;overflow:hidden}
.progress-bar-thin{height:100%;border-radius:10px;transition:width .8s ease}
.blocked-card{animation:slideUp .2s ease}
@keyframes slideUp{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}
</style>
{% for label, messages in app.flashes %}{% for message in messages %}<div class="alert alert-{{ label == "error" ? "danger" : label }} alert-dismissible fade show" style="border-radius:12px">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>{% endfor %}{% endfor %}
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="kpi-card">
      <div class="kpi-bg" style="background:#6366f1"></div>
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="kpi-icon" style="background:#eef2ff;color:#6366f1"><i class="bi bi-buildings"></i></div>
        <span class="badge" style="background:#eef2ff;color:#6366f1;border-radius:20px;font-size:10px">TOTAL</span>
      </div>
      <div class="h2 fw-bold mb-1" style="letter-spacing:-1px">{{ total }}</div>
      <div class="small text-muted mb-3">Propiedades registradas</div>
      <div class="d-flex gap-1">{% for i in 1..8 %}<div style="flex:1;height:24px;background:{{ i <= 6 ? "#6366f1" : "#e5e7eb" }};border-radius:4px;opacity:{{ 0.3 + i*0.1 }}"></div>{% endfor %}</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="kpi-card" style="border-color:#fde68a">
      <div class="kpi-bg" style="background:#f59e0b"></div>
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="kpi-icon" style="background:#fef3c7;color:#d97706"><i class="bi bi-lock-fill"></i></div>
        <span class="badge" style="background:#fef3c7;color:#92400e;border-radius:20px;font-size:10px"><i class="bi bi-exclamation-triangle me-1"></i>BLOQ</span>
      </div>
      <div class="h2 fw-bold mb-1" style="color:#92400e">{{ blockedIds|length }}</div>
      <div class="small text-muted mb-2">Con liquidaciones</div>
      <div class="progress-thin"><div class="progress-bar-thin" style="width:{{ total>0 ? (blockedIds|length*100/total)|round : 0 }}%;background:#f59e0b"></div></div>
      <div class="small mt-2" style="font-size:11px;color:#b45309">{{ total>0 ? (blockedIds|length*100/total)|round : 0 }}% no eliminable</div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="kpi-card" style="border-color:#bbf7d0">
      <div class="kpi-bg" style="background:#10b981"></div>
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="kpi-icon" style="background:#dcfce7;color:#059669"><i class="bi bi-check-circle-fill"></i></div>
        <span class="badge" style="background:#dcfce7;color:#065f46;border-radius:20px;font-size:10px">LIBRE</span>
      </div>
      <div class="h2 fw-bold mb-1" style="color:#065f46">{{ total - blockedIds|length }}</div>
      <div class="small text-muted mb-2">Disponibles para eliminar</div>
      <div class="d-flex align-items-center gap-2 mt-2">
        <div style="flex:1" class="progress-thin"><div class="progress-bar-thin" style="width:{{ total>0 ? ((total-blockedIds|length)*100/total)|round : 0 }}%;background:#10b981"></div></div>
        <span style="font-size:11px;font-weight:600;color:#059669">{{ total>0 ? ((total-blockedIds|length)*100/total)|round : 0 }}%</span>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="kpi-card">
      <div class="kpi-bg" style="background:#8b5cf6"></div>
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="kpi-icon" style="background:#f3e8ff;color:#7c3aed"><i class="bi bi-graph-up-arrow"></i></div>
        <span class="badge" style="background:#f3e8ff;color:#6d28d9;border-radius:20px;font-size:10px">{{ metrics.ocupacionPct }}% OCUP</span>
      </div>
      <div class="d-flex align-items-end gap-3 mb-2">
        <div class="h2 fw-bold mb-0">{{ metrics.ocupacionPct }}%</div>
        <svg width="60" height="24" viewBox="0 0 60 24"><path d="M0 20 Q10 10 20 12 T40 8 T60 4" stroke="#8b5cf6" stroke-width="2.5" fill="none" stroke-linecap="round"/><circle cx="55" cy="6" r="3" fill="#8b5cf6"/></svg>
      </div>
      <div class="small text-muted">Ocupación / uso actual</div>
      <div class="d-flex gap-2 mt-3">
        <div style="flex:1;text-align:center;background:#f9fafb;border-radius:10px;padding:6px"><div style="font-size:10px;color:#6b7280">OCUP</div><div style="font-weight:700;font-size:13px">{{ metrics.ocupadas }}</div></div>
        <div style="flex:1;text-align:center;background:#f9fafb;border-radius:10px;padding:6px"><div style="font-size:10px;color:#6b7280">VAC</div><div style="font-weight:700;font-size:13px">{{ total - blockedIds|length }}</div></div>
      </div>
    </div>
  </div>
</div>
<div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
<div><h3 class="mb-0" style="font-weight:800;letter-spacing:-.5px">Propiedades</h3><p class="small text-muted mb-0">{{ total }} registros • <span style="color:#d97706">{{ blockedIds|length }} bloqueadas</span> • <span style="color:#059669">{{ total-blockedIds|length }} libres</span></p></div>
<div class="d-flex gap-2"><input id="search-property" class="form-control" placeholder="Filtrar..." style="width:300px;border-radius:12px;border:1px solid #e5e7eb"><a href="javascript:void(0)" onclick="openCrudModal('{{ path("app_property_new") }}')" class="btn text-white" style="background:#6366f1;border-radius:12px;font-weight:600">+ Nueva</a></div>
</div>
<div class="card" style="border-radius:20px;overflow:visible;border:1px solid #f3f4f6;box-shadow:0 4px 12px rgba(0,0,0,.03)"><div class="table-responsive" style="overflow:visible"><table class="table mb-0" style="overflow:visible"><thead><tr style="background:#f9fafb"><th style="padding:14px 16px;font-size:11px;color:#6b7280">#</th><th style="padding:14px 16px;font-size:11px;color:#6b7280">DIRECCIÓN</th><th style="padding:14px 16px;font-size:11px;color:#6b7280">COMUNA</th><th style="padding:14px 16px;font-size:11px;color:#6b7280">ROL</th><th style="padding:14px 16px;font-size:11px;color:#6b7280">PROPIETARIO</th><th style="padding:14px 16px;font-size:11px;color:#6b7280;text-align:right">ACCIONES</th></tr></thead><tbody id="tbody-property">{% include "property/_rows.html.twig" with {"properties": properties, "blockedIds": blockedIds, "blockedMap": blockedMap} %}</tbody></table></div></div>
{% if pages > 1 %}<div class="d-flex justify-content-center mt-4 gap-1">{% for p in 1..pages %}<a href="?page={{ p }}&q={{ q }}" class="btn btn-sm {{ p==page ? "text-white shadow-sm" : "" }}" style="{{ p==page ? "background:#6366f1" : "background:white;border:1px solid #e5e7eb" }};border-radius:12px;min-width:40px;height:40px;display:inline-flex;align-items:center;justify-content:center;font-weight:600">{{ p }}</a>{% endfor %}</div>{% endif %}
<script>
document.addEventListener("DOMContentLoaded",function(){
var I=document.getElementById("search-property"),T=document.getElementById("tbody-property");
if(I){ I.addEventListener("input",function(){ var q=this.value.toLowerCase().trim(); T.querySelectorAll("tr").forEach(function(r){ if(!r.hasAttribute("data-search")) return; r.style.display=!q||(r.getAttribute("data-search")||"").toLowerCase().indexOf(q)!==-1?"":"none"; }); }); }
document.querySelectorAll(".btn-blocked-info").forEach(function(btn){
  var card=document.getElementById("card-"+btn.dataset.id); if(!card) return;
  btn.addEventListener("mouseenter",function(){ document.querySelectorAll(".blocked-card").forEach(c=>c.style.display="none"); card.style.display="block"; });
  btn.addEventListener("mouseleave",function(){ setTimeout(()=>{ if(!card.matches(":hover")) card.style.display="none"; },200); });
  card.addEventListener("mouseleave",function(){ card.style.display="none"; });
  btn.addEventListener("click",function(e){ e.preventDefault(); card.style.display = card.style.display==="none"?"block":"none"; });
});
document.addEventListener("click",function(e){ if(!e.target.closest(".btn-blocked-info") && !e.target.closest(".blocked-card")){ document.querySelectorAll(".blocked-card").forEach(c=>c.style.display="none"); } });
});
</script>
{% endblock %}
