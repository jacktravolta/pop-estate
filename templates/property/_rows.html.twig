{% for property in properties %}
<tr data-search="{{ property.direccion }} {{ property.comuna }} {{ property.rol }} {{ property.ciudad }} {{ property.owner ? property.owner.nombre : '' }}">
  <td style="padding:12px 16px;font-size:13px">{{ property.id }}</td>
  <td style="padding:12px 16px;font-size:13px;font-weight:600">{{ property.direccion }}</td>
  <td style="padding:12px 16px;font-size:13px">{{ property.comuna }}</td>
  <td style="padding:12px 16px;font-size:13px">{{ property.rol }}</td>
  <td style="padding:12px 16px;font-size:13px">{{ property.owner ? property.owner.nombre : '-' }}</td>
  <td style="padding:12px 16px;text-align:right">
    <div class="d-flex justify-content-end gap-1">
      <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_property_edit', {'id': property.id}) }}')" class="btn btn-sm" style="background:#eef2ff;color:#6366f1;border-radius:10px"><i class="bi bi-pencil"></i></a>
      {% if property.id in blockedIds %}
        <span class="btn btn-sm" style="background:#fef3c7;color:#d97706;border-radius:10px" title="{{ blockedMap[property.id] ?? 'Con liquidaciones' }}"><i class="bi bi-lock-fill"></i></span>
      {% else %}
        <a href="{{ path('app_property_delete', {'id': property.id}) }}" class="btn btn-sm" style="background:#fee2e2;color:#ef4444;border-radius:10px"><i class="bi bi-trash"></i></a>
      {% endif %}
    </div>
  </td>
</tr>
{% else %}
<tr><td colspan="6" class="text-center p-4 text-muted">Sin propiedades</td></tr>
{% endfor %}
