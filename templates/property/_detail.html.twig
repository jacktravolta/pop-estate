<div class="p-3" style="animation:fadeUp .35s cubic-bezier(.16,1,.3,1)">
<div class="d-flex justify-content-between mb-3">
<div><span class="badge rounded-pill" style="background:#f1f5f9; color:#475569; font-size:11px; padding:6px 12px">{{ property.comuna ?? 'Providencia' }}</span> <span class="badge bg-white border ms-1" style="font-size:11px; padding:6px 12px">Rol: {{ property.rol ?? '389-73' }}</span><h3 class="fw-bold mt-2" style="font-size:22px">{{ property.direccion }}</h3></div>
<div class="d-flex gap-2"><a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_property_edit', {id:property.id}) }}?modal=1','Editar')" class="btn btn-light rounded-pill btn-sm">Editar</a></div>
</div>
<div class="row g-3">
<div class="col-6"><div class="card-modern p-3"><div class="small text-uppercase fw-bold text-muted" style="font-size:10px">Empresa</div><div class="fw-bold mt-1" style="font-size:14px">{{ property.company ? (property.company.razonSocial ?? property.company.nombre) : 'Laura Rodriguez SpA' }}</div><div class="small text-muted">{{ property.company.rut ?? '' }}</div></div></div>
<div class="col-6"><div class="card-modern p-3"><div class="small text-uppercase fw-bold text-muted" style="font-size:10px">Propietario</div><div class="fw-bold mt-1" style="font-size:14px">{{ property.owner ? property.owner.nombre : 'Carlos Perez' }}</div><div class="small text-muted">{{ property.owner.rut ?? property.owner.email ?? '' }}</div></div></div>
</div>
</div>
