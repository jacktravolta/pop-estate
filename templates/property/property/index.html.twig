{% extends 'base.html.twig' %}{% block title %}Propiedades{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1">Propiedades</h3><p class="text-muted small mb-0">{{ pagination.getTotalItemCount }} registradas</p></div>
  <a href="{{ path('app_property_new') }}" class="btn btn-indigo rounded-pill"><i class="bi bi-plus-lg me-1"></i> Nueva propiedad</a>
</div>
{% include 'company/_search.html.twig' %}
<div class="card-modern p-3">
<div class="table-responsive">
<table class="table align-middle mb-0"><thead><tr class="small text-uppercase text-muted"><th>Dirección</th><th>Rol</th><th>Comuna</th><th>Empresa</th><th>Propietario</th><th class="text-end">Acciones</th></tr></thead>
<tbody>{% for p in pagination %}<tr>
<td class="fw-semibold">{{ p.direccion }}</td>
<td><span class="badge bg-light text-dark border">{{ p.rol|default('—') }}</span></td>
<td>{{ p.comuna|default('—') }}</td>
<td class="small">{{ p.company ? p.company.razonSocial : '—' }}</td>
<td class="small">{{ p.owner ? p.owner.nombre : '—' }}</td>
<td class="text-end">
<a href="{{ path('app_property_show',{'id':p.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye"></i></a>
<a href="{{ path('app_property_edit',{'id':p.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-pencil"></i></a>
<form method="post" action="{{ path('app_property_delete',{'id':p.id}) }}" onsubmit="return confirm('¿Eliminar {{ p.direccion }}?')" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ p.id) }}"><button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button></form>
</td></tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">Sin resultados para "{{ q }}"</td></tr>{% endfor %}</tbody>
</table></div>
<div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
</div>{% endblock %}
