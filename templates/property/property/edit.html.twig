{% extends 'base.html.twig' %}{% block title %}Editar {{ property.direccion }}{% endblock %}{% block body %}
<a href="{{ path('app_property_show', {'id': property.id}) }}" class="btn btn-sm btn-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Volver</a>
<h3 class="fw-bold mb-1">Editar propiedad</h3><p class="text-muted small mb-4">{{ property.direccion }}</p>
<div class="card-modern p-4 p-md-5"><div class="form-modern">
{{ form_start(form) }}
<div class="row g-3">
  <div class="col-md-8">{{ form_row(form.direccion) }}</div>
  <div class="col-md-4">{{ form_row(form.rol) }}</div>
  <div class="col-md-4">{{ form_row(form.comuna) }}</div>
  <div class="col-md-4">{{ form_row(form.ciudad) }}</div>
  <div class="col-md-6">{{ form_row(form.company) }}</div>
  <div class="col-md-6">{{ form_row(form.owner) }}</div>
</div>
<div class="mt-4 d-flex gap-2">
  <button class="btn btn-indigo px-4">Actualizar</button>
  <a href="{{ path('app_property_show', {'id': property.id}) }}" class="btn btn-light rounded-pill px-4">Cancelar</a>
</div>
{{ form_end(form) }}
</div></div>
{% endblock %}
