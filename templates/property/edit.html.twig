{% extends "base_ajax.html.twig" %}
{% block body %}
<h5 class="fw-bold mb-3"><i class="bi bi-pencil-square me-2" style="color:#6366f1"></i>Editar #{{ property.id }}</h5>
{{ form_start(form) }}
<div class="row g-3">
{% for child in form %}{% if child.vars.name != "_token" %}
<div class="col-12 {% if child.vars.name in ["comuna","rol"] %}col-md-6{% endif %}">
<label class="form-label small text-muted text-uppercase" style="font-size:11px">{{ child.vars.label|default(child.vars.name) }}</label>
{{ form_widget(child, {"attr":{"class":"form-control","style":"border-radius:12px;height:44px;background:#f9fafb"}}) }}
{{ form_errors(child) }}
</div>
{% endif %}{% endfor %}
</div>
<div class="d-flex justify-content-end gap-2 mt-4">
<button type="button" class="btn" style="background:#f3f4f6;border-radius:12px" data-bs-dismiss="modal">Cancelar</button>
<button class="btn text-white" style="background:#6366f1;border-radius:12px">Actualizar</button>
</div>
{{ form_end(form) }}
{% endblock %}
