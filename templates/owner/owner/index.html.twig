{% extends 'base.html.twig' %}{% block title %}Propietarios{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1">Propietarios</h3><p class="text-muted small mb-0">{{ pagination.getTotalItemCount }} registrados</p></div>
  <a href="{{ path('app_owner_new') }}" class="btn btn-indigo rounded-pill"><i class="bi bi-plus-lg me-1"></i> Nuevo propietario</a>
</div>
{% include 'company/_search.html.twig' %}
<div class="card-modern p-3">
<div class="table-responsive">
<table class="table align-middle mb-0"><thead><tr class="small text-uppercase text-muted"><th>RUT</th><th>Nombre</th><th>Comuna</th><th>Email</th><th class="text-end">Acciones</th></tr></thead>
<tbody>{% for o in pagination %}<tr>
<td><span class="badge bg-light text-dark border">{{ o.rut }}</span></td>
<td class="fw-semibold">{{ o.nombre }}</td>
<td>{{ o.comuna|default('—') }}</td>
<td class="small text-muted">{{ o.email|default('—') }}</td>
<td class="text-end"><a href="{{ path('app_owner_show',{'id':o.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye"></i></a> <a href="{{ path('app_owner_edit',{'id':o.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-pencil"></i></a>
<form method="post" action="{{ path('app_owner_delete',{'id':o.id}) }}" onsubmit="return confirm('¿Eliminar?')" class="d-inline"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ o.id) }}"><button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button></form>
</td></tr>{% else %}<tr><td colspan="5" class="text-center py-5 text-muted">Sin resultados para "{{ q }}"</td></tr>{% endfor %}</tbody>
</table></div>
<div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
</div>{% endblock %}
