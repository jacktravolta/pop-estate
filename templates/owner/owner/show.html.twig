{% extends 'base.html.twig' %}{% block title %}{{ owner.nombre }}{% endblock %}{% block body %}
<a href="{{ path('app_owner_index') }}" class="btn btn-sm btn-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Volver</a>
<div class="d-flex justify-content-between align-items-center mb-4"><h3 class="fw-bold mb-0">{{ owner.nombre }}</h3><div class="d-flex gap-2"><a href="{{ path('app_owner_edit', {'id': owner.id}) }}" class="btn btn-light rounded-pill"><i class="bi bi-pencil"></i> Editar</a><form method="post" action="{{ path('app_owner_delete', {'id': owner.id}) }}" onsubmit="return confirm('¿Eliminar?')"><button class="btn btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button></form></div></div>
<div class="card-modern p-4 p-md-5"><div class="row g-3"><div class="col-md-4"><label class="small text-uppercase fw-bold text-muted">RUT</label><div class="fw-semibold">{{ owner.rut }}</div></div><div class="col-md-4"><label class="small text-uppercase fw-bold text-muted">Email</label><div>{{ owner.email|default('—') }}</div></div><div class="col-md-8"><label class="small text-uppercase fw-bold text-muted">Dirección</label><div>{{ owner.direccion|default('—') }}</div></div></div></div>
{% endblock %}
