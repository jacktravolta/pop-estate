{% extends app.request.isXmlHttpRequest ? 'base_ajax.html.twig' : 'base.html.twig' %}
{% block body %}
<div class="p-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div class="d-flex gap-3 align-items-center">
      <div style="width:48px;height:48px;background:#eef2ff;border-radius:14px;display:flex;align-items:center;justify-content:center"><i class="bi bi-person" style="font-size:22px;color:#6366f1"></i></div>
      <div>
        <h5 class="fw-bold mb-0">#{{ owner.id }} {{ owner.nombre }}</h5>
        <small style="font-size:12px;color:#64748b;font-family:monospace;background:#f3f4f6;padding:2px 6px;border-radius:6px">{{ owner.rut }}</small>
        {% if hasProperties %}<span class="badge ms-2" style="background:#6366f1;color:white">{{ propCount }} propiedades</span>{% else %}<span class="badge ms-2" style="background:#f3f4f6;color:#9ca3af">Sin propiedades</span>{% endif %}
      </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>

  <div class="row g-2 mb-3" style="font-size:12px">
    <div class="col-6"><div class="p-2 rounded-3" style="background:#f8fafc;border:1px solid #eef2f7"><small style="font-size:10px;color:#9ca3af;font-weight:700">GIRO</small><div>{{ owner.giro|default('-') }}</div></div></div>
    <div class="col-6"><div class="p-2 rounded-3" style="background:#f8fafc;border:1px solid #eef2f7"><small style="font-size:10px;color:#9ca3af;font-weight:700">EMAIL</small><div>{{ owner.email|default('-') }}</div></div></div>
    <div class="col-12"><div class="p-2 rounded-3" style="background:#f8fafc;border:1px solid #eef2f7"><small style="font-size:10px;color:#9ca3af;font-weight:700">DIRECCIÓN</small><div>{{ owner.direccion|default('-') }} {{ owner.comuna ? '• '~owner.comuna : '' }} {{ owner.ciudad ? '• '~owner.ciudad : '' }}</div></div></div>
  </div>

  <div class="d-flex gap-2 mt-4">
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_owner_edit', {'id': owner.id}) }}')" class="btn flex-fill" style="background:#6366f1;color:white;border-radius:12px;height:42px">Editar</a>
    <button type="button" class="btn btn-light flex-fill" data-bs-dismiss="modal" style="border-radius:12px;height:42px">Cerrar</button>
  </div>
</div>
{% endblock %}
