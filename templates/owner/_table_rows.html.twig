{% for owner in owners %}
  {% set propCount = repo.countPropertiesByOwner(owner) %}
  <tr>
    <td style="padding:12px 16px"><span style="background:#f3f4f6;border-radius:8px;padding:4px 8px;font-size:11px;font-weight:700">#{{ owner.id }}</span></td>
    <td><span class="fw-bold" style="font-family:monospace;background:#eef2ff;color:#4338ca;padding:4px 8px;border-radius:8px;font-size:12px">{{ owner.rut }}</span></td>
    <td><div class="fw-bold" style="font-size:13px">{{ owner.nombre }}</div><small style="font-size:11px;color:#9ca3af">{{ owner.giro|default('Sin giro')|slice(0,40) }}</small></td>
    <td><div style="font-size:12px">{{ owner.comuna|default('-') }}</div><small style="font-size:11px;color:#64748b">{{ owner.ciudad|default('') }}</small></td>
    <td><div style="font-size:12px">{{ owner.email|default('-') }}</div></td>
    <td>{% if propCount > 0 %}<span class="badge" style="background:#6366f1;color:white;border-radius:20px">{{ propCount }} <i class="bi bi-house"></i></span>{% else %}<span class="badge" style="background:#f3f4f6;color:#9ca3af">0</span>{% endif %}</td>
    <td style="text-align:right;padding-right:16px">
      <div class="d-inline-flex gap-1">
        {# VER - req #2 #}
        <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_owner_show', {'id': owner.id}) }}')" class="btn btn-sm" title="Ver" style="background:#f5f3ff;color:#7c3aed;border-radius:10px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:1px solid #ede9fe"><i class="bi bi-eye"></i></a>
        {# EDITAR - req #2 #}
        <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_owner_edit', {'id': owner.id}) }}')" class="btn btn-sm" title="Editar" style="background:#eef2ff;color:#6366f1;border-radius:10px;width:32px;height:32px;display:flex;align-items:center;justify-content:center"><i class="bi bi-pencil"></i></a>
        {# ELIMINAR con lógica DB - req #2 #}
        {% if propCount > 0 %}
          <button class="btn btn-sm" disabled title="No se puede eliminar: tiene {{ propCount }} propiedad(es)" style="background:#f3f4f6;color:#9ca3af;border-radius:10px;width:32px;height:32px;cursor:not-allowed"><i class="bi bi-trash"></i></button>
        {% else %}
          <form method="post" action="{{ path('app_owner_delete', {'id': owner.id}) }}" onsubmit="return confirm('¿Eliminar {{ owner.nombre }}?')" style="display:inline">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ owner.id) }}">
            <button class="btn btn-sm" title="Eliminar" style="background:#fef2f2;color:#ef4444;border-radius:10px;width:32px;height:32px;border:1px solid #fee2e2"><i class="bi bi-trash"></i></button>
          </form>
        {% endif %}
      </div>
    </td>
  </tr>
{% else %}
  <tr><td colspan="7" class="text-center py-5"><div style="color:#9ca3af"><i class="bi bi-people" style="font-size:28px"></i><div class="mt-2" style="font-size:13px">Sin propietarios{% if q %} para "{{ q }}"{% endif %}</div></div></td></tr>
{% endfor %}
