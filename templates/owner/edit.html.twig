{% extends app.request.headers.get('X-Requested-With') == 'XMLHttpRequest' ? 'base_ajax.html.twig' : 'base.html.twig' %}
{% block body %}
<div class="p-1">
  <div class="d-flex align-items-center gap-2 mb-4"><div style="width:36px; height:36px; background:#eef2ff; border-radius:10px; display:flex; align-items:center; justify-content:center"><i class="bi bi-person" style="color:#6366f1"></i></div><div><h5 class="mb-0 fw-bold">Editar Propietario #{{ owner.id }}</h5></div></div>
  {{ form_start(form, {'attr': {'action': path('app_owner_edit', {'id': owner.id})}}) }}
    {% for field in form %}{% if field.vars.name != '_token' %}<div class="mb-2">{{ form_label(field) }}{{ form_widget(field) }}{{ form_errors(field) }}</div>{% endif %}{% endfor %}
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top:1px solid #f3f4f6"><button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius:12px">Cancelar</button><button type="submit" class="btn text-white" style="background:#6366f1; border-radius:12px">Actualizar</button></div>
  {{ form_end(form) }}
</div>
{% endblock %}
