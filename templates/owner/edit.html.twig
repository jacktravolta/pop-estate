{% extends app.request.isXmlHttpRequest? 'base_ajax.html.twig' : 'base.html.twig' %}
{% block body %}
<div class="p-2">
  <div class="d-flex align-items-center gap-3 mb-4">
    <div style="width:42px;height:42px;background:#f5f3ff;border-radius:12px;display:flex;align-items:center;justify-content:center"><i class="bi bi-pencil" style="color:#7c3aed;font-size:18px"></i></div>
    <div><h5 class="mb-0 fw-bold" style="font-size:15px">Editar #{{ owner.id }}</h5><small style="font-size:11px;color:#9ca3af">{{ owner.nombre }}</small></div>
    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
  </div>

  {{ form_start(form, {'attr': {'id':'owner-form','action':path('app_owner_edit',{'id':owner.id}),'novalidate':'novalidate','style':'display:flex;flex-direction:column;gap:14px'}}) }}

  <div class="row g-3">
    <div class="col-5">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#374151">RUT *</label>
      <div class="position-relative">
        {{ form_widget(form.rut, {'attr':{'id':'rut-input','class':'form-control','autocomplete':'off','style':'height:44px;border-radius:12px;border:1px solid #e5e7eb;font-size:13px;padding-right:36px'}}) }}
        <span id="rut-icon" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);font-size:14px"></span>
      </div>
      <div id="rut-feedback" style="font-size:11px;margin-top:6px;min-height:16px"></div>
      {{ form_errors(form.rut) }}
    </div>
    <div class="col-7">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#374151">NOMBRE *</label>
      {{ form_widget(form.nombre, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #e5e7eb;font-size:13px'}}) }}
      {{ form_errors(form.nombre) }}
    </div>
    <div class="col-12">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#9ca3af">GIRO</label>
      {{ form_widget(form.giro, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #eef2f7;font-size:13px;background:#fcfcff'}}) }}
    </div>
    <div class="col-12">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#9ca3af">DIRECCIÓN</label>
      {{ form_widget(form.direccion, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #eef2f7;font-size:13px;background:#fcfcff'}}) }}
    </div>
    <div class="col-6">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#9ca3af">COMUNA</label>
      {{ form_widget(form.comuna, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #eef2f7;font-size:13px'}}) }}
    </div>
    <div class="col-6">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#9ca3af">CIUDAD</label>
      {{ form_widget(form.ciudad, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #eef2f7;font-size:13px'}}) }}
    </div>
    <div class="col-12">
      <label class="form-label" style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#374151">EMAIL</label>
      {{ form_widget(form.email, {'attr':{'class':'form-control','style':'height:44px;border-radius:12px;border:1px solid #e5e7eb;font-size:13px'}}) }}
      {{ form_errors(form.email) }}
    </div>
  </div>

  {{ form_widget(form._token) }}
  <div class="d-flex justify-content-end gap-2 mt-3 pt-3" style="border-top:1px solid #f3f4f6">
    <button type="button" class="btn btn-light fw-bold" data-bs-dismiss="modal" style="border-radius:12px;height:42px;padding:0 20px;font-size:13px">Cancelar</button>
    <button type="submit" id="btn-submit" class="btn text-white fw-bold" style="background:#6366f1;border-radius:12px;height:42px;padding:0 24px;font-size:13px">Actualizar</button>
  </div>
  {{ form_end(form, {'render_rest': false}) }}
</div>
<script>
function cleanRut(rut){ return rut.replace(/[^0-9kK]/g,'').toUpperCase(); }
function formatRut(rut){ let c=cleanRut(rut); if(c.length<=1) return c; let body=c.slice(0,-1); let dv=c.slice(-1); body=body.replace(/\B(?=(\d{3})+(?!\d))/g,"."); return body+"-"+dv; }
function validaRut(rut){ let c=cleanRut(rut); if(c.length<2) return false; let body=c.slice(0,-1); let dv=c.slice(-1); if(body.length<7) return false; let sum=0,mul=2; for(let i=body.length-1;i>=0;i--){ sum+=parseInt(body[i])*mul; mul=mul===7?2:mul+1; } let res=11-(sum%11); let dvr=res===11?'0':res===10?'K':res.toString(); return dvr===dv; }
const input=document.getElementById('rut-input'); const feedback=document.getElementById('rut-feedback'); const icon=document.getElementById('rut-icon'); const btn=document.getElementById('btn-submit');
if(input){ input.addEventListener('input',function(e){ let raw=e.target.value; let formatted=formatRut(raw); e.target.value=formatted; let c=cleanRut(formatted); if(c.length<2){feedback.innerHTML='';icon.innerHTML='';input.style.borderColor='#e5e7eb';input.style.background='#fff';btn.disabled=true;return;} if(c.length>=2&&c.length<8){feedback.innerHTML='<span style="color:#f59e0b">Incompleto...</span>';icon.innerHTML='<i class="bi bi-dash-circle" style="color:#f59e0b"></i>';input.style.borderColor='#fde68a';input.style.background='#fffbeb';btn.disabled=true;return;} if(validaRut(formatted)){feedback.innerHTML='<span style="color:#10b981"><i class="bi bi-check-circle-fill"></i> RUT válido</span>';icon.innerHTML='<i class="bi bi-check-circle-fill" style="color:#10b981"></i>';input.style.borderColor='#6366f1';input.style.background='#eef2ff';input.style.boxShadow='0 0 0 3px rgba(99,102,241,.15)';btn.disabled=false;}else{feedback.innerHTML='<span style="color:#ef4444"><i class="bi bi-x-circle-fill"></i> RUT inválido</span>';icon.innerHTML='<i class="bi bi-x-circle-fill" style="color:#ef4444"></i>';input.style.borderColor='#ef4444';input.style.background='#fef2f2';btn.disabled=true;}}); if(input.value){input.dispatchEvent(new Event('input'));} }
</script>
{% endblock %}
