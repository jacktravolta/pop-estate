<div style="font-family:Inter,system-ui;max-width:100%;background:#f8fafc;border-radius:20px;overflow:hidden;border:1.5px solid #e2e8f0">
  <div style="background:white;padding:22px 20px;border-bottom:1.5px solid #e0e7ff;position:relative">
    <div style="position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#6366f1,#a78bfa)"></div>
    <div class="d-flex align-items-start gap-3">
      <div style="width:44px;height:44px;background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <i class="bi bi-receipt" style="color:#6366f1;font-size:20px"></i>
      </div>
      <div class="flex-fill">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#6366f1">LIQUIDACIÓN #{{ settlement.id }}</div>
            <div style="font-size:17px;font-weight:800;color:#0f172a;margin-top:4px;line-height:1.3">{{ settlement.property.direccion ?? settlement.property.direccionCompleta ?? 'Propiedad' }}</div>
            <div style="font-size:11px;color:#64748b;margin-top:4px"><i class="bi bi-geo-alt me-1" style="color:#a5b4fc"></i>{{ settlement.property.comuna ?? '' }} {{ settlement.property.ciudad ?? '' }}</div>
          </div>
          <span class="badge" style="border-radius:20px;padding:7px 12px;font-size:10px;font-weight:800;{% if settlement.estado == 'PAGADA' %}background:#ecfdf5;color:#059669;border:1px solid #a7f3d0{% elseif settlement.estado == 'VENCIDA' %}background:#fef2f2;color:#991b1b;border:1px solid #fecaca{% else %}background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe{% endif %}">{{ settlement.estado ?? 'PENDIENTE' }}</span>
        </div>
        <div class="mt-3">
          <span style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:20px;padding:5px 10px;font-size:11px;color:#475569"><i class="bi bi-calendar3 me-1" style="color:#6366f1"></i>{{ settlement.fechaInicio|date('d/m/Y') }} → {{ settlement.fechaTermino|date('d/m/Y') }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="p-3">
    <div style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#6366f1;margin-bottom:10px">DETALLE DE MOVIMIENTOS — FORMATO 2</div>
    <div style="display:flex;flex-direction:column;gap:10px">
      {% for item in settlement.items %}
        <div style="background:{% if loop.index is even %}#f1f5f9{% else %}white{% endif %};border:1.5px solid {% if loop.index is even %}#e2e8f0{% else %}#e0e7ff{% endif %};border-radius:14px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;{% if loop.index is even %}border-left:3px solid #c7d2fe{% else %}border-left:3px solid #6366f1{% endif %}">
          <div class="flex-fill">
            <div style="font-size:13px;font-weight:600;color:#0f172a">{{ item.descripcion }}</div>
            <div class="mt-1"><span style="font-size:9px;font-weight:800;letter-spacing:.06em;padding:4px 8px;border-radius:20px;{% if item.tipo == 'DESCUENTO' %}background:#fef3c7;color:#92400e;border:1px solid #fde68a{% else %}background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe{% endif %}">{{ item.tipo }}</span></div>
          </div>
          <div class="text-end"><div style="font-size:15px;font-weight:800;color:{% if item.tipo == 'DESCUENTO' %}#ef4444{% else %}#0f172a{% endif %}">{% if item.tipo == 'DESCUENTO' %}-{% endif %}${{ item.monto|number_format(0, ',', '.') }}</div></div>
        </div>
      {% endfor %}
    </div>

    {% set cargo = 0 %}{% set desc = 0 %}
    {% for i in settlement.items %}{% if i.tipo == 'DESCUENTO' %}{% set desc = desc + i.monto %}{% else %}{% set cargo = cargo + i.monto %}{% endif %}{% endfor %}
    {% set neto = cargo - desc %}{% set iva = (neto * 0.19)|round %}{% set total = neto + iva %}

    <div class="mt-4" style="background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:16px;padding:16px;position:relative;overflow:hidden">
      <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#6366f1,#a78bfa)"></div>
      <div style="font-size:10px;font-weight:800;letter-spacing:.08em;color:#4338ca;margin-bottom:12px">RESUMEN</div>
      <div style="background:white;border:1px solid #e0e7ff;border-radius:12px;padding:12px">
        <div class="d-flex justify-content-between mb-2" style="font-size:12px;color:#475569"><span>Cargos</span><b>${{ cargo|number_format(0, ',', '.') }}</b></div>
        <div class="d-flex justify-content-between mb-2" style="font-size:12px;color:#475569"><span>Descuentos</span><b style="color:#ef4444">-${{ desc|number_format(0, ',', '.') }}</b></div>
        <div class="d-flex justify-content-between mb-2" style="font-size:12px;color:#475569"><span>Neto</span><b>${{ neto|number_format(0, ',', '.') }}</b></div>
        <div class="d-flex justify-content-between pt-2 mt-2" style="border-top:1px solid #e0e7ff;font-size:12px"><span>IVA 19%</span><b>${{ iva|number_format(0, ',', '.') }}</b></div>
        <div class="d-flex justify-content-between pt-3 mt-2 align-items-center" style="border-top:1.5px solid #c7d2fe"><span style="font-weight:800;color:#4338ca;font-size:11px">TOTAL</span><b style="font-size:22px;color:#4338ca">${{ total|number_format(0, ',', '.') }}</b></div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-4">
      <button class="btn flex-fill" style="background:white;border:1.5px solid #e2e8f0;border-radius:12px;font-weight:600;padding:11px;font-size:13px" data-bs-dismiss="modal">Cerrar</button>
      <a href="{{ path('app_settlement_pdf', {'id': settlement.id}) }}" class="btn flex-fill" style="background:#6366f1;color:white;border-radius:12px;font-weight:600;padding:11px;font-size:13px;border:0"><i class="bi bi-file-earmark-pdf me-1"></i> PDF</a>
    </div>
  </div>
</div>
