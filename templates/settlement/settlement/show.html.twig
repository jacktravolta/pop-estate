{% extends 'base.html.twig' %}
{% block title %}Liquidación #{{ settlement.id }}{% endblock %}
{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4"><div><a href="{{ path('app_settlement_index') }}" class="btn btn-sm btn-light mb-2"><i class="bi bi-arrow-left"></i> Liquidaciones</a><h3 class="fw-bold mb-0">Liquidación #{{ settlement.id }}</h3><small class="text-muted">{{ settlement.periodo|default('') }} • {{ settlement.estado }}</small></div><div class="d-flex gap-2"><form method="post" action="{{ path('app_settlement_recalcular', {id: settlement.id}) }}"><button class="btn btn-light"><i class="bi bi-calculator"></i> Recalcular</button></form><form method="post" action="{{ path('app_settlement_pagar', {id: settlement.id}) }}"><button class="btn btn-success"><i class="bi bi-check-circle"></i> Pagar</button></form><form method="post" action="{{ path('app_settlement_anular', {id: settlement.id}) }}"><button class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Anular</button></form></div></div>
<div class="row g-3"><div class="col-lg-8"><div class="card-modern"><div class="card-modern-header"><h5 class="mb-0">Cargos</h5></div><div class="table-responsive"><table class="table table-modern"><thead><tr><th>Concepto</th><th class="text-end">Monto</th></tr></thead><tbody>{% for item in settlement.items|default([]) %}<tr><td>{{ item.concepto|default(item.descripcion) }}</td><td class="text-end">${{ item.monto|number_format(0,',','.') }}</td></tr>{% else %}<tr><td colspan="2" class="text-center py-3 text-muted">Sin cargos</td></tr>{% endfor %}</tbody><tfoot><tr><th>Total</th><th class="text-end">${{ settlement.total|default(0)|number_format(0,',','.') }}</th></tr></tfoot></table></div></div></div><div class="col-lg-4"><div class="card-modern p-4"><h5>Detalle</h5><div class="mt-3"><label class="small text-muted">Estado</label><div><span class="badge bg-success-soft text-success">{{ settlement.estado }}</span></div></div><div class="mt-3"><label class="small text-muted">Propiedad</label><div class="fw-semibold">{{ settlement.property.address|default('—') }}</div></div></div></div></div>
{% endblock %}
