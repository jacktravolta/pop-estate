{% extends 'base.html.twig' %}{% block title %}Liquidaciones{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1">Liquidaciones</h3><p class="text-muted small mb-0">{{ pagination.getTotalItemCount }} registradas</p></div>
  <a href="{{ path('app_settlement_new') }}" class="btn btn-indigo rounded-pill"><i class="bi bi-plus-lg me-1"></i> Nueva liquidación</a>
</div>
<form method="get" class="d-flex gap-2 mb-3">
  <div class="flex-grow-1 position-relative">
    <i class="bi bi-search position-absolute" style="left:14px; top:50%; transform:translateY(-50%); color:#94a3b8;"></i>
    <input type="text" name="q" value="{{ q|default('') }}" placeholder="Buscar por dirección o estado..." class="form-control ps-5" style="border-radius:12px; border:2px solid #e2e8f0; padding:.7rem 1rem .7rem 2.5rem;">
  </div>
  <select name="estado" class="form-select" style="max-width:160px; border-radius:12px;">
    <option value="">Todos</option>
    <option value="PENDIENTE" {{ estado=='PENDIENTE'?'selected':'' }}>Pendiente</option>
    <option value="PAGADA" {{ estado=='PAGADA'?'selected':'' }}>Pagada</option>
    <option value="ANULADA" {{ estado=='ANULADA'?'selected':'' }}>Anulada</option>
  </select>
  <button class="btn btn-light rounded-pill px-4">Filtrar</button>
  {% if q or estado %}<a href="{{ path('app_settlement_index') }}" class="btn btn-outline-secondary rounded-pill px-3">Limpiar</a>{% endif %}
</form>
<div class="small text-muted mb-2">Mostrando {{ pagination.getTotalItemCount }} resultados</div>
<div class="card-modern p-3">
<div class="table-responsive">
<table class="table align-middle mb-0"><thead><tr class="small text-uppercase text-muted"><th>#</th><th>Propiedad</th><th>Periodo</th><th>Estado</th><th class="text-end">Total</th><th class="text-end">Acciones</th></tr></thead>
<tbody>{% for s in pagination %}<tr>
<td><span class="badge bg-light text-dark border">#{{ s.id }}</span></td>
<td class="fw-semibold">{{ s.property ? s.property.direccion : '—' }}</td>
<td class="small">{{ s.fechaInicio|date('d/m/Y') }} - {{ s.fechaTermino|date('d/m/Y') }}</td>
<td>{% if s.estado=='PAGADA' %}<span class="badge bg-success">Pagada</span>{% elseif s.estado=='PENDIENTE' %}<span class="badge bg-warning text-dark">Pendiente</span>{% else %}<span class="badge bg-secondary">{{ s.estado }}</span>{% endif %}</td>
<td class="text-end fw-bold">${{ s.total|number_format(0,',','.') }}</td>
<td class="text-end"><a href="{{ path('app_settlement_show',{'id':s.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye"></i></a> <a href="{{ path('app_settlement_edit',{'id':s.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-pencil"></i></a></td>
</tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">Sin resultados para "{{ q }}"</td></tr>{% endfor %}</tbody>
</table></div>
<div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
</div>{% endblock %}
