{% extends 'base.html.twig' %}{% block title %}Nueva Liquidación{% endblock %}{% block body %}
<a href="{{ path('app_settlement_index') }}" class="btn btn-sm btn-light rounded-pill mb-3"><i class="bi bi-arrow-left"></i> Liquidaciones</a>
<h3 class="fw-bold mb-1">Nueva liquidación</h3><p class="text-muted small mb-4">Genera cobro mensual para una propiedad</p>
<div class="card-modern p-4 p-md-5"><div class="form-modern">
{{ form_start(form) }}
<div class="form-section">
  <div class="form-section-title"><i class="bi bi-house-door text-primary"></i> Propiedad y periodo</div>
  <div class="row">
    <div class="col-md-6">{{ form_row(form.property, {'attr':{'class':'form-control'}}) }}</div>
    <div class="col-md-3">{{ form_row(form.fechaInicio) }}</div>
    <div class="col-md-3">{{ form_row(form.fechaTermino) }}</div>
  </div>
</div>

<div class="form-section">
  <div class="form-section-title"><i class="bi bi-list-ul text-primary"></i> Items de liquidación</div>
  <div class="items-collection">
    {% for itemForm in form.items %}
      <div class="row g-2 mb-2 p-2 bg-white rounded-3 border">
        <div class="col-md-5">{{ form_row(itemForm.descripcion) }}</div>
        <div class="col-md-3">{{ form_row(itemForm.monto) }}</div>
        <div class="col-md-3">{{ form_row(itemForm.tipo) }}</div>
        <div class="col-md-1 d-flex align-items-end"><button type="button" class="btn btn-sm btn-light w-100" onclick="this.closest('.row').remove()"><i class="bi bi-trash"></i></button></div>
      </div>
    {% endfor %}
  </div>
  {{ form_errors(form.items) }}
  <small class="text-muted">Arriendo, gastos comunes, multas, descuentos...</small>
</div>

<div class="mt-4 d-flex gap-2">
  <button class="btn btn-indigo px-4"><i class="bi bi-receipt me-1"></i> Guardar liquidación</button>
  <a href="{{ path('app_settlement_index') }}" class="btn btn-light rounded-pill px-4">Cancelar</a>
</div>
{{ form_end(form) }}
</div></div>
{% endblock %}
