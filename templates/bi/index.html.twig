{% extends 'base.html.twig' %}{% block title %}BI & Analytics{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
<div><h3 class="fw-bold mb-1">BI & Analytics</h3><p class="text-muted small mb-0">Inteligencia de negocio • 202 propiedades analizadas</p></div>
<div class="d-flex gap-2"><button class="btn btn-light rounded-pill"><i class="bi bi-download me-1"></i> Exportar</button><button class="btn btn-indigo rounded-pill"><i class="bi bi-stars me-1"></i> Generar insights AI</button></div>
</div>
<div class="row g-3 mb-4">
<div class="col-md-3"><div class="card-modern p-4"><div class="small text-uppercase text-muted fw-bold" style="font-size:10px">Recaudación mensual</div><div class="h4 fw-bold mt-2 mb-0">$42.8M</div><div class="small text-success"><i class="bi bi-arrow-up"></i> +12.3% vs mes anterior</div></div></div>
<div class="col-md-3"><div class="card-modern p-4"><div class="small text-uppercase text-muted fw-bold" style="font-size:10px">Morosidad</div><div class="h4 fw-bold mt-2 mb-0">4.2%</div><div class="small text-danger"><i class="bi bi-arrow-down"></i> -0.8% vs mes anterior</div></div></div>
<div class="col-md-3"><div class="card-modern p-4"><div class="small text-uppercase text-muted fw-bold" style="font-size:10px">Propiedades ocupadas</div><div class="h4 fw-bold mt-2 mb-0">187 / 202</div><div class="small text-muted">92.5% ocupación</div></div></div>
<div class="col-md-3"><div class="card-modern p-4" style="background:linear-gradient(135deg,#6366f1,#8b5cf6); color:white; border:none"><div class="small text-uppercase fw-bold opacity-75" style="font-size:10px">IA Prediction</div><div class="h6 fw-bold mt-2 mb-1">Próximo mes +$3.2M</div><div class="small opacity-75" style="font-size:11px">Confianza 94%</div></div></div>
</div>
<div class="row g-3">
<div class="col-md-8"><div class="card-modern p-4"><h6 class="fw-bold mb-3">Evolución recaudación</h6><canvas id="chartRevenue" height="200"></canvas></div></div>
<div class="col-md-4"><div class="card-modern p-4 h-100"><h6 class="fw-bold mb-3">Por comuna</h6><canvas id="chartComuna" height="200"></canvas></div></div>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
new Chart(document.getElementById('chartRevenue'),{type:'line', data:{labels:['Ene','Feb','Mar','Abr','May','Jun'], datasets:[{label:'Recaudación', data:[32,38,35,42,40,42.8], borderColor:'#6366f1', backgroundColor:'rgba(99,102,241,.1)', tension:.4, fill:true}]}, options:{plugins:{legend:{display:false}}, scales:{y:{beginAtZero:true}}}});
new Chart(document.getElementById('chartComuna'),{type:'doughnut', data:{labels:['Providencia','Las Condes','Ñuñoa','Santiago'], datasets:[{data:[45,25,18,12], backgroundColor:['#6366f1','#8b5cf6','#06b6d4','#10b981']}]}, options:{plugins:{legend:{position:'bottom', labels:{boxWidth:10, font:{size:11}}}}}});
</script>
{% endblock %}
