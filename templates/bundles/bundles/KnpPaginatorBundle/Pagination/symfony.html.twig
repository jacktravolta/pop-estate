{% if pageCount > 1 %}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4 px-2">
  <div class="small text-muted">
    Mostrando <strong>{{ firstItemNumber }}-{{ lastItemNumber }}</strong> de <strong>{{ totalCount }}</strong> resultados
  </div>
  <nav>
    <ul class="pagination pagination-modern mb-0">
      {% if first is defined and current != first %}
        <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({(pageParameterName): first})) }}"><i class="bi bi-chevron-double-left"></i></a></li>
      {% endif %}
      {% if previous is defined %}
        <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({(pageParameterName): previous})) }}"><i class="bi bi-chevron-left"></i></a></li>
      {% else %}
        <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-left"></i></span></li>
      {% endif %}

      {% for page in pagesInRange %}
        {% if page != current %}
          <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({(pageParameterName): page})) }}">{{ page }}</a></li>
        {% else %}
          <li class="page-item active"><span class="page-link">{{ page }}</span></li>
        {% endif %}
      {% endfor %}

      {% if next is defined %}
        <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({(pageParameterName): next})) }}"><i class="bi bi-chevron-right"></i></a></li>
      {% else %}
        <li class="page-item disabled"><span class="page-link"><i class="bi bi-chevron-right"></i></span></li>
      {% endif %}
      {% if last is defined and current != last %}
        <li class="page-item"><a class="page-link" href="{{ path(route, query|merge({(pageParameterName): last})) }}"><i class="bi bi-chevron-double-right"></i></a></li>
      {% endif %}
    </ul>
  </nav>
</div>
{% endif %}
