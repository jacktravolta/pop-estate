{% extends 'base.html.twig' %}
{% block title %}Generar Factura por Periodos{% endblock %}
{% block body %}
<div class="container-fluid p-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div><h4 class="fw-bold mb-1">Generar facturas por periodos - cruce de datos</h4><small class="text-muted">Cruza liquidaciones PAGADAS + propiedades + periodo → genera invoices</small></div>
    <a href="{{ path('app_invoice_index') }}" class="btn btn-light rounded-pill border">← Volver a facturas</a>
  </div>

  <div class="row g-3">
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4" style="border:1.5px solid #e2e8f0!important">
        <h6 class="fw-bold mb-3" style="color:#6366f1">1. Selecciona periodo</h6>
        <form method="post" action="{{ path('app_invoice_generate_period') }}" id="genForm">
          <label class="form-label" style="font-size:12px">Fecha inicio</label>
          <input type="date" name="inicio" id="inicio" value="2025-01-01" class="form-control mb-3" style="border-radius:12px" required>
          <label class="form-label" style="font-size:12px">Fecha término</label>
          <input type="date" name="fin" id="fin" value="2025-12-31" class="form-control mb-3" style="border-radius:12px" required>
          <label class="form-label" style="font-size:12px">Propiedad (opcional - si vacío genera 1 por propiedad)</label>
          <select name="property" id="property" class="form-select mb-3" style="border-radius:12px"><option value="">Todas las propiedades (agrupa por propiedad)</option>{% for p in properties %}<option value="{{ p.id }}">{{ p.direccion }}</option>{% endfor %}</select>
          <label class="form-label" style="font-size:12px">Emisor</label>
          <input type="text" name="emisor" value="Pop Estate" class="form-control mb-3" style="border-radius:12px" required>
          <label class="form-label" style="font-size:12px">Receptor (opcional)</label>
          <input type="text" name="receptor" placeholder="Cliente o propiedad" class="form-control mb-4" style="border-radius:12px">
          <button type="submit" class="btn w-100 rounded-pill" style="background:#6366f1;color:white;font-weight:600">+ Generar facturas cruzadas</button>
        </form>
      </div>
    </div>
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4" style="border:1.5px solid #e2e8f0!important;min-height:500px">
        <div class="d-flex justify-content-between align-items-center mb-3"><h6 class="fw-bold mb-0" style="color:#0f172a">Preview tiempo real - cruce settlements</h6><span class="badge rounded-pill" style="background:#eef2ff;color:#6366f1" id="previewBadge">Esperando periodo...</span></div>
        <div class="row g-2 mb-3" id="kpiPreview" style="display:none">
          <div class="col-6"><div class="p-3 rounded-4" style="background:#eef2ff"><small style="font-size:10px;color:#6366f1">LIQUIDACIONES CRUZADAS</small><h4 class="mb-0 fw-bold" id="kpiCount">0</h4></div></div>
          <div class="col-6"><div class="p-3 rounded-4" style="background:#ecfdf5"><small style="font-size:10px;color:#059669">TOTAL A FACTURAR</small><h4 class="mb-0 fw-bold" id="kpiTotal">$0</h4></div></div>
        </div>
        <div id="breakdown" class="mb-3"></div>
        <div class="table-responsive" style="max-height:400px;overflow:auto"><table class="table table-sm" style="font-size:12px" id="previewTable"><thead style="position:sticky;top:0;background:#f8fafc;font-size:10px;color:#64748b"><tr><th>#</th><th>Propiedad</th><th>Periodo</th><th>Total</th><th>Estado</th></tr></thead><tbody id="previewTbody"><tr><td colspan="5" class="text-center py-4 text-muted">Selecciona fechas para cruzar datos</td></tr></tbody></table></div>
      </div>
    </div>
  </div>
</div>

<script>
async function loadPreview(){
  const inicio=document.getElementById('inicio').value;
  const fin=document.getElementById('fin').value;
  const prop=document.getElementById('property').value;
  if(!inicio||!fin) return;
  document.getElementById('previewBadge').innerText='Cruzando...';
  try{
    const res=await fetch(`/invoices/actions/preview-by-period?inicio=${inicio}&fin=${fin}&property=${prop}`);
    const data=await res.json();
    if(!data.ok){ document.getElementById('previewBadge').innerText=data.error; return; }
    document.getElementById('previewBadge').innerText=`${data.count} liquidaciones PAGADAS`;
    document.getElementById('kpiPreview').style.display='flex';
    document.getElementById('kpiCount').innerText=data.count;
    document.getElementById('kpiTotal').innerText=data.total_fmt;
    let htmlBd=''; for(const [dir,total] of Object.entries(data.breakdown)){ htmlBd+=`<span class='badge rounded-pill me-1 mb-1' style='background:#f8fafc;border:1px solid #e2e8f0'>${dir}: $${Number(total).toLocaleString('es-CL')}</span>`; }
    document.getElementById('breakdown').innerHTML=htmlBd;
    let tbody=''; data.settlements.forEach(s=>{ tbody+=`<tr><td>#${s.id}</td><td>${s.propiedad}</td><td>${s.periodo}</td><td class='fw-bold' style='color:#6366f1'>${s.total_fmt}</td><td><span class='badge' style='background:#eef2ff;color:#4338ca;font-size:10px'>${s.estado}</span></td></tr>`; });
    document.getElementById('previewTbody').innerHTML=tbody||`<tr><td colspan=5 class='text-center py-4 text-muted'>No hay liquidaciones PAGADAS en ese periodo</td></tr>`;
  }catch(e){ document.getElementById('previewBadge').innerText='Error cruce: '+e.message; }
}
document.getElementById('inicio').addEventListener('change', loadPreview);
document.getElementById('fin').addEventListener('change', loadPreview);
document.getElementById('property').addEventListener('change', loadPreview);
document.addEventListener('DOMContentLoaded', loadPreview);
</script>
{% endblock %}
