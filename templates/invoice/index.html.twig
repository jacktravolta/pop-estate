{% extends 'base.html.twig' %}{% block title %}Facturas{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
<div><h4 class="fw-bold mb-1">Facturas</h4><p class="small text-muted mb-0">{{ pagination.getTotalItemCount }} facturas</p></div>
<button onclick="openCrudModal('{{ path('app_invoice_new') }}','Nueva factura')" class="btn btn-indigo rounded-pill px-4">+ Nueva factura</button>
</div>
{% include 'components/_search.html.twig' %}
<div class="card-modern p-0 overflow-hidden"><div class="table-responsive">
<table class="table table-hover align-middle mb-0" id="crudTable">
<thead class="bg-light"><tr>
<th style="font-size:11px" class="text-muted">#</th>
<th style="font-size:11px" class="text-muted">Folio</th>
<th style="font-size:11px" class="text-muted">Receptor</th>
<th style="font-size:11px" class="text-muted">Periodo</th>
<th style="font-size:11px" class="text-muted text-end">Total</th>
<th style="font-size:11px" class="text-muted">Estado</th>
<th style="font-size:11px" class="text-end text-muted">Acciones</th>
</tr></thead>
<tbody>
{% for i in pagination %}
{% set est = i.estado|upper %}
<tr {% if est=='PAGADA' %}style="opacity:.75"{% endif %}>
<td class="small text-muted">#{{ i.id }}</td>
<td class="fw-semibold">{{ i.folio }}</td>
<td class="small">{{ i.receptor|default('-')|slice(0,25) }}</td>
<td class="small text-muted">{{ i.periodo|default('-') }}</td>
<td class="text-end fw-bold">${{ i.total|number_format(0,',','.') }}</td>
<td>{% if est=='PAGADA' %}<span class="badge rounded-pill" style="background:#ecfdf5; color:#059669; border:1px solid #a7f3d0; font-size:10px">PAGADA • FINAL</span>{% elseif est=='PENDIENTE' %}<span class="badge rounded-pill" style="background:#fffbeb; color:#d97706; border:1px solid #fde68a; font-size:10px">PENDIENTE</span>{% elseif est=='EMITIDA' %}<span class="badge rounded-pill" style="background:#eef2ff; color:#4f46e5; border:1px solid #c7d2fe; font-size:10px">EMITIDA</span>{% else %}<span class="badge rounded-pill" style="background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; font-size:10px">{{ est }}</span>{% endif %}</td>
<td class="text-end">
<div class="btn-group btn-group-sm">
<button class="btn btn-light rounded-pill" onclick="verFactura({{ i.id }})"><i class="bi bi-eye"></i> Ver</button>
{% if est=='PENDIENTE' %}<button class="btn btn-indigo rounded-pill" onclick="fetch('/invoices/{{ i.id }}/emit',{method:'POST'}).then(()=>location.reload())">Emitir</button>{% endif %}
{% if est=='EMITIDA' or est=='PENDIENTE' %}<button class="btn btn-success rounded-pill" onclick="fetch('/invoices/{{ i.id }}/pay',{method:'POST'}).then(()=>location.reload())">Pagar</button>{% endif %}
</div>
</td>
</tr>
{% else %}<tr><td colspan="7" class="text-center py-5 text-muted">Sin facturas</td></tr>{% endfor %}
</tbody>
</table></div></div>
{% include 'components/_paginator.html.twig' %}
<div class="modal fade" id="facturaModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" style="border-radius:20px; overflow:hidden; border:none"><div class="modal-header border-0" style="background:#f8fafc"><h6 class="fw-bold mb-0" id="facturaTitle">Factura</h6><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-0" style="background:#eef2f7"><iframe id="facturaFrame" style="width:100%; height:72vh; border:0; background:white"></iframe></div><div class="modal-footer border-0 d-flex justify-content-between"><div><a id="facturaPdf" href="#" class="btn btn-dark rounded-pill btn-sm px-3">PDF</a><a id="facturaPrint" href="#" target="_blank" class="btn btn-light border rounded-pill btn-sm px-3">Print</a></div><button class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cerrar</button></div></div></div></div>
<script>function verFactura(id){document.getElementById('facturaTitle').innerText='Factura #'+id;document.getElementById('facturaPdf').href='/invoices/'+id+'/pdf';document.getElementById('facturaPrint').href='/invoices/'+id+'/print';document.getElementById('facturaFrame').src='/invoices/'+id+'/print';new bootstrap.Modal(document.getElementById('facturaModal')).show();}</script>
{% endblock %}
