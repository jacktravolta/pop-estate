{% extends 'base.html.twig' %}{% block title %}Facturas{% endblock %}{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1">Facturas</h3><p class="text-muted small mb-0">{{ pagination.getTotalItemCount }} registradas</p></div>
  <a href="{{ path('app_invoice_new') }}" class="btn btn-indigo rounded-pill"><i class="bi bi-plus-lg me-1"></i> Nueva factura</a>
</div>
{% include 'company/_search.html.twig' %}
<div class="card-modern p-3">
<div class="table-responsive"><table class="table align-middle mb-0"><thead><tr class="small text-uppercase text-muted"><th>Folio</th><th>Emisor</th><th>Periodo</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
<tbody>{% for i in pagination %}<tr>
<td><span class="badge bg-light text-dark border">{{ i.folio }}</span></td>
<td class="fw-semibold">{{ i.emisor }}</td><td class="small">{{ i.periodo|default('—') }}</td><td><span class="badge bg-light text-dark border">{{ i.estado }}</span></td>
<td class="text-end fw-bold">${{ i.total|number_format(0,',','.') }}</td>
<td class="text-end"><a href="{{ path('app_invoice_show',{'id':i.id}) }}" class="btn btn-sm btn-light rounded-pill"><i class="bi bi-eye"></i></a></td>
</tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">Sin resultados</td></tr>{% endfor %}</tbody></table></div>
<div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
</div>{% endblock %}
