{% extends 'base.html.twig' %}
{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:100vh; background:#f8fafc; font-family: Inter, system-ui">
  <div class="card border-0" style="width:380px; border-radius:24px; border:1px solid #eef2f7; box-shadow:0 10px 40px rgba(0,0,0,.06)">
    <div class="card-body p-4 p-md-5 text-center">
      <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width:48px; height:48px; background:#6366f1; border-radius:12px; color:white; font-size:22px"><i class="bi bi-buildings"></i></div>
      <h5 class="fw-bold mb-1" style="font-size:20px; color:#111827">Pop Estate</h5>
      <p class="mb-4" style="font-size:13px; color:#6b7280">Ingresa a tu cuenta</p>
      
      <form method="post" class="text-start">
        {% if error %}<div class="alert alert-danger py-2" style="font-size:12px; border-radius:10px">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
        <div class="mb-3">
          <label style="font-size:11px; font-weight:700; letter-spacing:.06em; color:#111827">EMAIL</label>
          <input type="email" name="email" value="{{ last_username|default('admin@pop.cl') }}" class="form-control mt-1" placeholder="admin@pop.cl" style="height:44px; border-radius:12px; border:1px solid #e5e7eb; font-size:13px" required>
        </div>
        <div class="mb-4">
          <label style="font-size:11px; font-weight:700; letter-spacing:.06em; color:#111827">CONTRASEÑA</label>
          <input type="password" name="password" class="form-control mt-1" placeholder="••••••••" style="height:44px; border-radius:12px; border:1px solid #e5e7eb; font-size:13px" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn w-100 text-white fw-semibold" type="submit" style="height:44px; background:#6366f1; border-radius:12px; font-size:14px; box-shadow:0 4px 14px rgba(99,102,241,.35)">Ingresar <i class="bi bi-arrow-right ms-1"></i></button>
        <div class="text-center mt-3" style="font-size:11px; color:#9ca3af">Demo: admin@pop.cl / admin123</div>
      </form>
    </div>
  </div>
</div>
{% endblock %}
{% block login %}{{ block('body') }}{% endblock %}
