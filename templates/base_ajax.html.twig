<div id="crudModalBody" class="p-4">{% block body %}{% endblock %}</div>
<script>
var form=document.querySelector("#crudModalBody form");
if(form){
form.addEventListener("submit",function(e){
e.preventDefault();
var fd=new FormData(form);
fetch(form.action,{method:form.method,body:fd,headers:{"X-Requested-With":"XMLHttpRequest"}})
.then(r=>r.text()).then(t=>{
if(t.trim()==="OK"){
var m=document.getElementById("crudModal");
if(window.bootstrap){var i=bootstrap.Modal.getInstance(m); if(i) i.hide();}
document.querySelectorAll(".modal-backdrop").forEach(b=>b.remove());
document.body.classList.remove("modal-open");
setTimeout(()=>location.reload(),200);
}else{document.getElementById("crudModalBody").innerHTML=t;}
});
});
}
</script>
