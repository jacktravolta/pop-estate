{% extends 'base.html.twig' %}{% block title %}Dashboard{% endblock %}{% block body %}
<style>.card-kpi{border:1px solid #eef2f7; border-radius:16px; background:white; box-shadow:0 1px 2px rgba(0,0,0,.04); transition:.15s}.card-kpi:hover{box-shadow:0 8px 24px rgba(0,0,0,.06); transform:translateY(-1px)}</style>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div><h3 class="fw-bold mb-1" style="letter-spacing:-.02em">Dashboard</h3><p class="text-muted small mb-0">Resumen real de Pop Estate — {{ "now"|date("d M Y") }}</p></div>
  <div class="d-flex gap-2">
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_settlement_new') }}')" class="btn text-white" style="background:#6366f1; border-radius:12px; box-shadow:0 4px 14px rgba(99,102,241,.3)"><i class="bi bi-plus-lg me-1"></i> Nueva liquidación</a>
  </div>
</div>

<!-- KPIs -->
<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card-kpi p-4">
    <div class="d-flex justify-content-between mb-3"><div style="width:40px; height:40px; background:#eef2ff; color:#6366f1; border-radius:12px; display:flex; align-items:center; justify-content:center"><i class="bi bi-building"></i></div><span class="badge bg-success-subtle text-success border" style="font-size:10px">+12%</span></div>
    <div class="small text-uppercase fw-bold" style="font-size:10px; letter-spacing:.08em; color:#9ca3af">Empresas</div><div class="h3 fw-bold mb-1">{{ counts.companies }}</div><div class="small text-muted" style="font-size:11px">202 RUT validado</div><a href="{{ path('app_company_index') }}" class="small text-decoration-none" style="color:#6366f1">Ver todas →</a>
  </div></div>
  <div class="col-md-3"><div class="card-kpi p-4">
    <div class="d-flex justify-content-between mb-3"><div style="width:40px; height:40px; background:#ecfdf5; color:#10b981; border-radius:12px; display:flex; align-items:center; justify-content:center"><i class="bi bi-houses"></i></div><span class="badge" style="background:#111827; color:white; font-size:10px">{{ ocupacion.pct }}% Ocup</span></div>
    <div class="small text-uppercase fw-bold" style="font-size:10px; letter-spacing:.08em; color:#9ca3af">Propiedades</div><div class="h3 fw-bold mb-1">{{ counts.properties }}</div><div class="progress mt-2" style="height:4px"><div class="progress-bar" style="width:{{ ocupacion.pct }}%; background:#6366f1"></div></div><div class="small text-muted mt-1" style="font-size:11px">{{ ocupacion.arrendadas }} arrendadas / {{ ocupacion.total }} total</div>
  </div></div>
  <div class="col-md-3"><div class="card-kpi p-4">
    <div class="d-flex justify-content-between mb-3"><div style="width:40px; height:40px; background:#fff7ed; color:#f59e0b; border-radius:12px; display:flex; align-items:center; justify-content:center"><i class="bi bi-receipt"></i></div><span class="small text-success fw-bold">↑ $</span></div>
    <div class="small text-uppercase fw-bold" style="font-size:10px; letter-spacing:.08em; color:#9ca3af">Liquidaciones</div><div class="h3 fw-bold mb-1">{{ counts.settlements }}</div><div class="small fw-bold" style="color:#111827">${{ (ingresosMes/1000)|number_format(0,',','.') }}k este mes</div><a href="{{ path('app_settlement_index') }}" class="small text-decoration-none" style="color:#6366f1">Ver todas →</a>
  </div></div>
  <div class="col-md-3"><div class="card-kpi p-4">
    <div class="d-flex justify-content-between mb-3"><div style="width:40px; height:40px; background:#fef2f2; color:#ef4444; border-radius:12px; display:flex; align-items:center; justify-content:center"><i class="bi bi-file-invoice"></i></div><span class="badge bg-success-subtle text-success" style="font-size:10px">Pagadas</span></div>
    <div class="small text-uppercase fw-bold" style="font-size:10px; letter-spacing:.08em; color:#9ca3af">Facturas</div><div class="h3 fw-bold mb-1">{{ counts.invoices }}</div><div class="small text-muted" style="font-size:11px">{{ counts.invoices }} emitidas</div><a href="{{ path('app_invoice_index') }}" class="small text-decoration-none" style="color:#6366f1">Ver todas →</a>
  </div></div>
</div>

<!-- CHARTS -->
<div class="row g-3 mb-4">
  <div class="col-lg-8"><div class="card-kpi p-4"><div class="d-flex justify-content-between align-items-center mb-3"><h6 class="fw-bold mb-0" style="font-size:13px">Ingresos últimos 6 meses</h6><span class="badge" style="background:#eef2ff; color:#6366f1; font-size:10px">Liquidaciones</span></div><div id="chart-ingresos" style="height:240px"></div></div></div>
  <div class="col-lg-4"><div class="card-kpi p-4"><h6 class="fw-bold mb-3" style="font-size:13px">Ocupación</h6><div id="chart-ocup" style="height:200px"></div><div class="d-flex justify-content-between mt-3" style="font-size:12px"><div><span style="width:8px; height:8px; background:#6366f1; display:inline-block; border-radius:99px; margin-right:6px"></span>Arrendadas {{ ocupacion.pct }}%</div><div><span style="width:8px; height:8px; background:#e5e7eb; display:inline-block; border-radius:99px; margin-right:6px"></span>Vacantes {{ 100-ocupacion.pct }}%</div></div></div></div>
</div>

<!-- TABLAS REALES -->
<div class="row g-3 mb-4">
  <div class="col-lg-6"><div class="card-kpi p-4"><div class="d-flex justify-content-between align-items-center mb-3"><h6 class="fw-bold mb-0" style="font-size:13px">Últimas propiedades</h6><a href="{{ path('app_property_index') }}" class="small" style="color:#6366f1; text-decoration:none">Ver todas</a></div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0" style="font-size:13px"><thead><tr><th style="font-size:10px; color:#9ca3af">Propiedad</th><th style="font-size:10px; color:#9ca3af">Comuna</th><th style="font-size:10px; color:#9ca3af">Estado</th></tr></thead><tbody>
    {% for p in latestProperties %}<tr><td><div class="fw-semibold">{{ p.direccion|default(p.address|default('Prop #'~p.id))|slice(0,28) }}</div><div class="small text-muted" style="font-size:11px">{{ p.rol|default('') }}</div></td><td class="small text-muted">{{ p.comuna|default('-') }}</td><td><span class="badge rounded-pill" style="background:#ecfdf5; color:#065f46; font-size:10px">Activa</span></td></tr>{% else %}<tr><td colspan="3" class="text-muted small">Sin propiedades aún</td></tr>{% endfor %}
    </tbody></table></div>
  </div></div>
  <div class="col-lg-6"><div class="card-kpi p-4"><div class="d-flex justify-content-between align-items-center mb-3"><h6 class="fw-bold mb-0" style="font-size:13px">Últimas liquidaciones</h6><a href="{{ path('app_settlement_index') }}" class="small" style="color:#6366f1; text-decoration:none">Ver todas</a></div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0" style="font-size:13px"><thead><tr><th style="font-size:10px; color:#9ca3af">Propiedad</th><th style="font-size:10px; color:#9ca3af">Fecha</th><th style="font-size:10px; color:#9ca3af">Total</th></tr></thead><tbody>
    {% for s in latestSettlements %}<tr><td><div class="fw-semibold">{{ s.property ? (s.property.direccion|default('Prop #'~s.property.id))|slice(0,24) : '—' }}</div></td><td class="small text-muted">{{ s.fechaInicio ? s.fechaInicio|date('d/m') : '' }} - {{ s.fechaTermino ? s.fechaTermino|date('d/m') : '' }}</td><td class="fw-bold">${{ (s.total ?? 0)|number_format(0,',','.') }}</td></tr>{% else %}<tr><td colspan="3" class="text-muted small">Sin liquidaciones aún</td></tr>{% endfor %}
    </tbody></table></div>
  </div></div>
</div>

<!-- ACCESOS -->
<div class="card-kpi p-4">
  <h6 class="fw-bold mb-3" style="font-size:13px">Accesos rápidos</h6>
  <div class="d-flex flex-wrap gap-2">
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_company_new') }}')" class="btn btn-light rounded-pill" style="border:1px solid #eef2f7; font-size:13px">Nueva empresa</a>
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_owner_new') }}')" class="btn btn-light rounded-pill" style="border:1px solid #eef2f7; font-size:13px">Nuevo propietario</a>
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_property_new') }}')" class="btn btn-light rounded-pill" style="border:1px solid #eef2f7; font-size:13px">Nueva propiedad</a>
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_settlement_new') }}')" class="btn btn-light rounded-pill" style="border:1px solid #eef2f7; font-size:13px">Nueva liquidación</a>
    <a href="javascript:void(0)" onclick="openCrudModal('{{ path('app_invoice_new') }}')" class="btn text-white rounded-pill" style="background:#6366f1; box-shadow:0 4px 14px rgba(99,102,241,.3); font-size:13px">+ Nueva factura</a>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
<script>
const monthlyData = {{ monthly|json_encode|raw }};
const labels = monthlyData.map(m => m.mes);
const montos = monthlyData.map(m => m.monto);
const ocupPct = {{ ocupacion.pct }};

new ApexCharts(document.querySelector("#chart-ingresos"), {
  chart:{type:'bar', height:240, toolbar:{show:false}, fontFamily:'Inter'},
  colors:['#6366f1'],
  series:[{name:'Monto', data:montos}],
  xaxis:{categories:labels, labels:{style:{fontSize:'11px', colors:'#9ca3af'}}},
  yaxis:{labels:{formatter:v=>'$'+(v/1000).toFixed(0)+'k', style:{colors:'#9ca3af'}}},
  plotOptions:{bar:{borderRadius:8, columnWidth:'42%'}},
  grid:{borderColor:'#f3f4f6', strokeDashArray:4},
  dataLabels:{enabled:false}
}).render();

new ApexCharts(document.querySelector("#chart-ocup"), {
  chart:{type:'donut', height:200, fontFamily:'Inter'},
  colors:['#6366f1','#e5e7eb'],
  series:[ocupPct, 100-ocupPct],
  labels:['Arrendadas','Vacantes'],
  legend:{show:false},
  dataLabels:{enabled:false},
  plotOptions:{pie:{donut:{size:'72%'}}}
}).render();
</script>
{% endblock %}
